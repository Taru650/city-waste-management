{
  "name": "@cwm/mvc-app",
  "version": "1.0.0",
  "private": true,
  "description": "City Waste Management: Next.js (MVC) + MySQL. One REST API for the website and the mobile apps.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev -p 3000\" \"tsx watch scripts/worker.ts\"",
    "dev:web": "next dev -p 3000",
    "build": "next build",
    "start": "concurrently -k -n web,worker -c cyan,magenta \"next start -p 3000\" \"tsx scripts/worker.ts\"",
    "worker": "tsx scripts/worker.ts",
    "setup": "npm run gen:secrets && npm run db:migrate && npm run db:seed",
    "gen:secrets": "tsx scripts/gen-secrets.ts",
    "doctor": "tsx scripts/doctor.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:rollback": "tsx scripts/db.ts rollback",
    "db:status": "tsx scripts/db.ts status",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset --yes",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "db:guards": "tsx scripts/db.ts guards"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@node-rs/argon2": "^2.2.2",
    "antd": "^6.6.7",
    "concurrently": "^10.0.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "exceljs": "^4.4.0",
    "jose": "^6.2.13",
    "knex": "^3.3.0",
    "leaflet": "1.9",
    "mysql2": "^3.24.6",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "swr": "^2.5.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
