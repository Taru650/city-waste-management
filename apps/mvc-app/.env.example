# City Waste Management (Next.js + MySQL). Copy this file to ".env" and fill the blanks:
#   Windows CMD:   copy .env.example .env
#   then run:      npm run gen:secrets      (fills the three secret values below; never overwrites a value)

NODE_ENV=development
APP_URL=http://localhost:3000

# ---- MySQL 8.0 or newer (use the official MySQL 8.4 installer; XAMPP/WAMP ship MariaDB, which is NOT supported) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cwm_mvc
DB_USER=cwm
DB_PASSWORD=cwm_dev_pass
# Used only by `npm test`: a separate database, so tests never touch your demo data.
DB_TEST_NAME=cwm_mvc_test
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000

# ---- Secrets: run `npm run gen:secrets` (do not share or commit them) ----
JWT_ACCESS_SECRET=
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TTL_DAYS_STAFF=7
REFRESH_TTL_DAYS_CITIZEN=30

# Browser cookies are marked Secure (HTTPS only) when true. Keep false on http://localhost, true in production.
COOKIE_SECURE=false
# Other websites allowed to call the API from a browser (comma separated origins). Mobile apps need nothing here.
CORS_ORIGINS=
# Number of reverse proxies in front of the app. 0 = none (local development: every client shares one rate-limit
# bucket, because the client IP cannot be trusted). In production set 1 (or more) and put an HTTPS proxy in front.
TRUST_PROXY_HOPS=0
RATE_LIMIT_GLOBAL_PER_MIN=240
RATE_LIMIT_AUTH_PER_MIN=20

# ---- Files (complaint photos and videos) ----
STORAGE_DIR=./storage
MEDIA_MAX_CAPTURE_AGE_HOURS=24
MEDIA_MAX_GPS_ACCURACY_M=100
VIDEO_MAX_SECONDS=30
# Optional. Install FFmpeg and set the full paths (Windows example: C:\ffmpeg\bin\ffmpeg.exe) so videos are
# compressed and get a thumbnail. Without it, videos are stored as uploaded.
FFMPEG_PATH=
FFPROBE_PATH=
# Optional ClamAV daemon for malware scanning. Without it only the EICAR test signature is rejected.
CLAMAV_HOST=
CLAMAV_PORT=3310

# ---- Push notifications (optional) ----
# Firebase service-account JSON on ONE line. Leave empty: notifications still appear inside the apps.
FCM_SERVICE_ACCOUNT_JSON=
FCM_API_BASE=https://fcm.googleapis.com

# ---- Email (password reset). "log" prints the reset link in the terminal; "smtp" sends real email. ----
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=Swachh Seva <no-reply@example.gov.in>

# ---- Privacy notice (DPDP Act): who citizens can contact. Required when NODE_ENV=production. ----
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

# ---- Demo data: the centre of the demo wards. Set it to where you will test the phone app. ----
DEMO_CENTER_LAT=21.2514
DEMO_CENTER_LNG=81.6296
