# Internal URL of the NestJS API (server-side only; never exposed to the browser)
API_URL=http://127.0.0.1:3000/api/v1
# Public origin of this portal, used for the CSRF origin check
PORTAL_ORIGIN=http://localhost:3001
# Origins the browser may load evidence photos/videos from (S3/MinIO public endpoint), comma-separated
MEDIA_ORIGINS=http://localhost:9000
# Map tiles
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Set to false only for plain-http development on a non-localhost host
COOKIE_SECURE=true
