NODE_ENV=development
PORT=3000
# Comma-separated list of browser origins allowed to call the API (the Next.js portal).
CORS_ORIGINS=http://localhost:3001

DATABASE_URL=postgres://postgres:postgres@localhost:5432/cwm

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-use-at-least-32-random-bytes-here!!
JWT_MFA_SECRET=change-me-another-32-random-bytes-for-mfa-step!!
# 32 bytes, base64. Encrypts PII (mobile, email, TOTP secrets) at rest.
PII_ENCRYPTION_KEY=
# 32 bytes, base64. Keyed hash used to look up mobile/email without decrypting.
PII_HASH_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS_CITIZEN=30
REFRESH_TOKEN_TTL_DAYS_STAFF=7
PASSWORD_RESET_URL=http://localhost:3001/reset-password

# Rate limits (requests per window, per client IP)
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10

# Optional: hCaptcha / reCAPTCHA server secret. Empty disables CAPTCHA (dev only; required in production).
CAPTCHA_SECRET=
CAPTCHA_VERIFY_URL=https://hcaptcha.com/siteverify

# Photo re-encoder: turbo (default, ~7x less CPU) | mozjpeg (~35 % smaller files). See infra/load/RESULTS.md.
PHOTO_ENCODER=turbo

# Play Integrity: how the mobile apps prove a genuine app on a genuine phone (they have no CAPTCHA).
# off (dev/test) | monitor (record verdicts, never block: use for rollout) | enforce (required in production)
PLAY_INTEGRITY_MODE=off
# Service account with Play Integrity API access, JSON base64 (required unless mode=off)
PLAY_INTEGRITY_SERVICE_ACCOUNT_B64=
PLAY_INTEGRITY_CITIZEN_PACKAGE=org.citywaste.cwm_citizen
PLAY_INTEGRITY_STAFF_PACKAGE=org.citywaste.cwm_staff
# Release signing-certificate SHA-256 digests as Play reports them (base64url), comma-separated (required in production)
PLAY_INTEGRITY_CERT_SHA256=
# Minimum device verdict: BASIC | DEVICE | STRONG
PLAY_INTEGRITY_CITIZEN_LEVEL=BASIC
PLAY_INTEGRITY_STAFF_LEVEL=DEVICE

# Bootstrap Web Admin created by `npm run seed`
SEED_ADMIN_MOBILE=9000000001
SEED_ADMIN_EMAIL=admin@example.gov.in
SEED_ADMIN_PASSWORD=

# Object storage (S3 / MinIO). Bucket must be private; the API hands out short-lived signed URLs.
S3_ENDPOINT=http://localhost:9000
# Host the mobile apps can reach, if different from S3_ENDPOINT (used to sign upload/view URLs).
S3_PUBLIC_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=cwm-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Media rules
MEDIA_MAX_CAPTURE_AGE_HOURS=24
MEDIA_MAX_GPS_ACCURACY_M=100
VIDEO_MAX_SECONDS=30
VIDEO_PRESET=slow
MEDIA_VIDEO_CONCURRENCY=1

# ClamAV daemon for malware scanning of uploads (required in production)
CLAMAV_HOST=
CLAMAV_PORT=3310

# Background jobs (BullMQ). api = HTTP only, worker = jobs only, all = both (dev).
REDIS_URL=redis://127.0.0.1:6379/0
PROCESS_ROLE=all

# Email: "smtp" is required in production, over TLS (smtps:// or ?requireTLS=true)
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=Swachh Seva <no-reply@example.gov.in>

# Push notifications: Firebase service-account JSON, base64. Empty = in-app notifications only.
FCM_SERVICE_ACCOUNT_B64=
